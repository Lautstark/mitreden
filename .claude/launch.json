{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spike",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "docs/spike/serve.py",
        "8771"
      ],
      "port": 8771
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
