{
  "name": "mitreden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn German sentences into audio files, so every device a child uses speaks in one voice. Runs entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "1.0.3",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#26d7819a7564f51486c837a225806d89e284c398",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
