{
  "name": "mitreden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn German sentences into audio files, so every device a child uses speaks in one voice. Runs entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "preflight": "node tools/installcheck.mjs",
    "test:e2e": "node tools/installcheck.mjs && npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test": "node tools/installcheck.mjs && vitest run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@lautstark/design": "github:Lautstark/design#v1.36.0",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.17.0",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.11.0",
    "@lautstark/werkzeuge": "github:Lautstark/werkzeuge#v1.3.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "1.18.0"
  },
  "devDependencies": {
    "@lautstark/toolchain": "github:Lautstark/toolchain#v1.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true
  }
}
