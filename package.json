{
  "name": "mitreden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn German sentences into audio files, so every device a child uses speaks in one voice. Runs entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@lautstark/design": "github:Lautstark/design#v1.14.1",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.2.0",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.7.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
