node_modules/
dist/
test-results/
playwright-report/
*.tsbuildinfo
# Vite's dependency-optimizer cache. It is rewritten on every dev run and its
# hashes describe one machine's node_modules, so a tracked copy is a working
# tree that is dirty from the moment anybody starts the server.
.vite/

# Audio never belongs in here, wherever it turns up: the recordings live in
# the browser, and anything rendered to disk is reproducible.
*.wav
*.mp3

# The container's own settings file, which it wrote next to the data it
# mounted. The container is gone and nothing in src/ reads this any more, so a
# copy on disk is a leftover rather than a setting - ignored so it stops
# showing up as untracked in every status.
config.json

# Credentials
.env
.env.*

# System
.DS_Store
